{
  "expo": {
    "name": "Ledgr",
    "slug": "ledgr",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "ledgr",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "assets": [
      "./assets/avenelle.ttf",
      "./assets/CalSans-Regular.ttf",
      "./assets/MuseoModerno-Black.ttf",
      "./assets/MuseoModerno-Medium.ttf",
      "./assets/MuseoModerno-Regular.ttf",
      "./assets/Chillax-Medium.otf",
      "./assets/Chillax-Regular.otf",
      "./assets/Chillax-Bold.otf",
      "./assets/Chillax-Semibold.otf",
      "./assets/Chillax-Light.otf",
      "./assets/GlacialIndifference-Regular.otf",
      "./assets/GlacialIndifference-Bold.otf"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-notifications", {
        "icon": "./assets/icon.png",
        "color": "#1A1A1A"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "art.ledgr.app",
      "buildNumber": "27",
      "supportsTablet": false,
      "entitlements": {
        "aps-environment": "production"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    }
  }
}
