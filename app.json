{
  "expo": {
    "name": "Ledgr",
    "slug": "ledgr",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "ledgr",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/white.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "art.ledgr.app",
      "buildNumber": "71",
      "supportsTablet": false,
      "entitlements": {
        "aps-environment": "production"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    }
  }
}
